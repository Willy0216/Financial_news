{
  "name": "financial-news-backend",
  "version": "1.0.0",
  "description": "Lean Financial News & Asset Tracking Backend in TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/index.ts",
    "dev:client": "npm --prefix client run dev",
    "build:server": "tsc",
    "build:client": "npm --prefix client run build",
    "build": "tsc && npm --prefix client run build",
    "start": "node dist/index.js",
    "test": "tsx tests/verify.ts",
    "test:e2e": "tsx tests/e2e-api.test.ts",
    "test:all": "tsx tests/verify.ts && tsx tests/e2e-api.test.ts"
  },
  "keywords": [
    "finance",
    "assets",
    "isin",
    "gemini",
    "express",
    "react",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.18.0",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "yahoo-finance2": "^2.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
